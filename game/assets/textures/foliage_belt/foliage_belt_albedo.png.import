[remap]

importer="texture"
type="CompressedTexture2D"

[deps]

source_file="res://assets/textures/foliage_belt/foliage_belt_albedo.png"

[params]

compress/mode=2
compress/high_quality=true
compress/normal_map=2
compress/channel_pack=0
