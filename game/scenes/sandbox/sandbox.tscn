[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;

// Ground placeholder: earth tone with 1 m minor and 10 m major grid lines for judging scale and speed.
uniform vec3 base_color : source_color = vec3(0.33, 0.33, 0.27);
uniform vec3 line_color : source_color = vec3(0.2, 0.2, 0.16);

varying vec2 world_xz;

void vertex() {
	world_xz = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xz;
}

float grid_line(vec2 p, float spacing) {
	vec2 cell = p / spacing;
	vec2 w = fwidth(cell);
	vec2 d = abs(fract(cell - 0.5) - 0.5) / w;
	float line = 1.0 - clamp(min(d.x, d.y), 0.0, 1.0);
	return line * (1.0 - smoothstep(0.1, 0.3, max(w.x, w.y)));
}

void fragment() {
	float line = max(0.5 * grid_line(world_xz, 1.0), grid_line(world_xz, 10.0));
	ALBEDO = mix(base_color, line_color, line);
	ROUGHNESS = 1.0;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_grid"]
shader = SubResource("Shader_grid")

