<Project Sdk="Microsoft.NET.Sdk">
  <!-- The headless replay (LOG-02): the sim core's own sources through simcore, no Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>replay</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../simcore/simcore.csproj" />
  </ItemGroup>

  <!-- The scripted flight's pilot: the suite's closed loop, flown on the published pose. -->
  <ItemGroup>
    <Compile Include="../../unity/Packages/com.fpv450.sim/Tests/SimPilot.cs" Link="SimPilot.cs" />
    <Compile Include="../../unity/Packages/com.fpv450.sim/Tests/World/WakeGridFixture.cs" Link="WakeGridFixture.cs" />
  </ItemGroup>

  <!-- The graze along the test range's wall (p7f-damage 1.3): a blade strike that chips the blades, logged and replayed; and
       the tipped landing into the range's soil (1.3's soil carve), which needs the soil's scenarios. -->
  <ItemGroup>
    <Compile Include="../../unity/Packages/com.fpv450.sim/Tests/StrikeScenarios.cs" Link="StrikeScenarios.cs" />
    <Compile Include="../../unity/Packages/com.fpv450.sim/Tests/ContactScenarios.cs" Link="ContactScenarios.cs" />
    <Compile Include="../../unity/Packages/com.fpv450.sim/Tests/RangeScenarios.cs" Link="RangeScenarios.cs" />
    <Compile Include="../../unity/Packages/com.fpv450.sim/Tests/CrosswindScenario.cs" Link="CrosswindScenario.cs" />
    <Compile Include="../../unity/Packages/com.fpv450.sim/Tests/SoilScenarios.cs" Link="SoilScenarios.cs" />
  </ItemGroup>
</Project>
