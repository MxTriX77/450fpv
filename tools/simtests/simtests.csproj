<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity package's own NUnit tests outside Unity. NUnit stays on 3.x:
       Unity's test framework ships NUnit 3, and NUnit 4 drops the classic asserts. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Fpv450.Sim.Tests</AssemblyName>
    <RootNamespace>Fpv450.Sim.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Packages/com.fpv450.sim/Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../simcore/simcore.csproj" />
  </ItemGroup>
</Project>
