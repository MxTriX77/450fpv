<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity project's own feed-core NUnit tests outside Unity, as simtests does for the sim package.
       NUnit stays on 3.x: Unity's test framework ships NUnit 3. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Fpv450.Feed.Tests</AssemblyName>
    <RootNamespace>Fpv450.Feed.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/_Project/Tests/EditMode/Feed/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../feedcore/feedcore.csproj" />
  </ItemGroup>
</Project>
