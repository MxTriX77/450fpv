<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine-free input layer, flight session (p6-input-app) and OSD content model (p4-feed 1.5), compiled from the Unity project's own sources (never a copy).
       netstandard2.1 is Unity's API level, so an API Unity lacks fails this build too. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Fpv450.Input.Radio</AssemblyName>
    <RootNamespace>Fpv450.Input.Radio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/_Project/Scripts/Input/Radio/**/*.cs" />
    <Compile Include="../../unity/Assets/_Project/Scripts/App/Session/**/*.cs" />
    <Compile Include="../../unity/Assets/_Project/Scripts/UI/Osd/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../simcore/simcore.csproj" />
    <ProjectReference Include="../feedcore/feedcore.csproj" />
  </ItemGroup>
</Project>
